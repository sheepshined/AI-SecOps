# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，勿提交）
# 注意：Web 服务（app.py）不读取本文件；本文件仅供 xdr_pipeline.py 命令行模式使用。
# Web 服务的 XDR/模型配置走 data/xdr_config.json 与 data/assistant_config.json。

# ===== XDR 连接配置（二选一）=====
XDR_BASE_URL=https://<xdr-host>:1443
# 方式一：连接码（十六进制，需 pycryptodome 解码 AK/SK）
XDR_AUTH_CODE=
# 方式二：AK/SK 直连
XDR_AK=
XDR_SK=

# ===== 命令行研判用的模型配置 =====
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_MODEL=your-model-name

# ===== 其他 =====
REQUEST_TIMEOUT=60
PIPELINE_COUNT=5
